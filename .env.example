# ==============================================================================
# Fidelity Life Assurance WhatsApp Bot - Environment Configuration Example
# Copy this file to .env and fill in your actual Meta developer credentials.
# Do NOT commit your actual .env file to version control.
# ==============================================================================

# Meta WhatsApp Cloud API Credentials
# Use a permanent System User token for any persistent environment. Temporary
# dashboard tokens expire and will stop inbound replies from being delivered.
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here

# WhatsApp Phone Number ID (From WhatsApp > API Setup in Meta Developer Dashboard)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Arbitrary secret string chosen by you for Meta Webhook verification handshake
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token_here

# Meta App Secret (From App Dashboard > App Settings > Basic > App Secret)
# Used to validate the X-Hub-Signature-256 header on incoming webhook events
META_APP_SECRET=your_meta_app_secret_here

# Meta Graph API Version (e.g., v20.0, v21.0)
META_GRAPH_API_VERSION=v21.0

# SQL Server 2022 using Windows integrated authentication and ODBC Driver 18.
# Replace localhost with the approved server/instance name for UAT and production.
DATABASE_URL=mssql+pyodbc://@localhost/FidelityWhatsAppBot?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes
SESSION_TTL_SECONDS=1800

# Fidelity customer, policy, payment-history, and claim-status API
CUSTOMER_POLICY_API_BASE_URL=https://approved-core-api.example.com
CUSTOMER_POLICY_API_TOKEN=your_core_api_token_here
CUSTOMER_VERIFICATION_PATH=/customers/verify
ONBOARDING_START_PATH=/onboarding
ONBOARDING_RELATIONSHIPS_PATH=/onboarding/{attempt_id}/relationships
ONBOARDING_LINK_PATH=/onboarding/{attempt_id}/links
POLICY_DETAILS_PATH=/policies/{policy_number}
PAYMENT_HISTORY_PATH=/policies/{policy_number}/payments
CLAIM_STATUS_PATH=/claims/{reference}

# Fidelity payment API
PAYMENT_API_BASE_URL=https://approved-payment-api.example.com
PAYMENT_API_TOKEN=your_payment_api_token_here
PAYMENT_INITIATION_PATH=/payments
PAYMENT_STATUS_PATH=/payments/{reference}
PAYMENT_PREPARATION_PATH=/payments/prepare
PAYMENT_VERIFICATION_START_PATH=/payments/verification/start
PAYMENT_VERIFICATION_CONFIRM_PATH=/payments/verification/confirm
PAYMENT_ELIGIBLE_POLICIES_PATH=/payments/eligible-policies
PAYMENT_METHODS_JSON={"ecocash":"EcoCash","omari":"O'mari","innbucks":"InnBucks","bank_transfer":"Bank Transfer","card":"Visa / Mastercard"}
BANK_TRANSFER_INSTRUCTIONS_JSON={}
PAYMENT_VERIFICATION_MAX_ATTEMPTS=3
PAYMENT_MAX_RETRIES=4

# Human-agent handoff
AGENT_NOTIFICATION_WEBHOOK_URL=https://approved-agent-platform.example.com/webhooks/escalations
AGENT_NOTIFICATION_TOKEN=your_agent_notification_token_here
ESCALATION_MATRIX_JSON={}
BUSINESS_TIMEZONE=Africa/Harare
BUSINESS_HOURS_JSON={}

# InsureTech product, quotation and application API. Prefer a service token.
# If no token is issued, use a dedicated service account (not a personal login).
INSURETECH_API_BASE_URL=https://insuretech-api.fidelitylife.co.zw
INSURETECH_API_TOKEN=
INSURETECH_API_EMAIL=
INSURETECH_API_PASSWORD=
INSURETECH_LOGIN_PATH=/auth/login
# Optional comma-separated fallback IPs when the host's normal DNS cannot resolve.
# TLS still verifies the original insuretech-api.fidelitylife.co.zw hostname.
INSURETECH_API_RESOLVED_IPS=
INSURETECH_PRODUCTS_PATH=/products
INSURETECH_PRODUCT_PATH=/products/{product_code}
INSURETECH_QUOTE_PATH=/products/{product_code}/quote
INSURETECH_APPLICATIONS_PATH=/products/{product_code}/applications
INSURETECH_APPLICATION_PATH=/products/{product_code}/applications/{application_id}
INSURETECH_APPLICATION_SUBMIT_PATH=/products/{product_code}/applications/{application_id}/submit
INSURETECH_PAYMENT_METHODS_PATH=/payments/methods
INSURETECH_PAYMENT_STATUS_PATH=/payments/{payment_id}/status
INSURETECH_PRODUCT_POLICY_NUMBER_PATH=/products/{product_code}/policy-number
INSURETECH_APPLICATION_POLICY_NUMBER_PATH=/products/{product_code}/applications/{application_id}/policy-number
INSURETECH_COVER_ACTIVATION_PATH=/products/{product_code}/applications/{application_id}/cover/activate
INSURETECH_POLICY_NUMBER_ENABLED=false
INSURETECH_COVER_ACTIVATION_ENABLED=false
INSURETECH_APPLICATION_TRACKING_ENABLED=false

# AI agent to chatbot handoff authentication
HANDOFF_API_KEY=replace_with_a_long_random_secret
INTERNAL_API_KEY=replace_with_a_separate_long_random_secret

# Sales, quotation and CRM integration boundaries. Do not populate these with
# placeholders in a deployed environment: empty means safely unavailable.
QUOTE_API_BASE_URL=
QUOTE_API_TOKEN=
QUOTE_REQUEST_PATH=/quotes
CRM_API_BASE_URL=
CRM_API_TOKEN=
CRM_LEAD_PATH=/leads
COMMERCIAL_RULES_PATH=data/commercial_rules.json

# Follow-up records are created even when sending is disabled. Sending requires
# an approved WhatsApp template mapping and explicit enablement.
FOLLOW_UP_ENABLED=false
FOLLOW_UP_TEMPLATES_JSON={}
FOLLOW_UP_WINDOW_HOURS=72

# Shared secret used to verify X-Payment-Signature (HMAC-SHA256) callbacks.
PAYMENT_CALLBACK_SECRET=

# Business-owned public content. Leave unverified links/numbers blank.
HEAD_OFFICE_ADDRESS=66 Julius Nyerere Way, Harare, Zimbabwe
TOLL_FREE_NUMBER=+263 8080835
CUSTOMER_CARE_EMAIL=customercare@fidelitylife.co.zw
FUNERAL_EMERGENCY_PHONE=
FLIMAS_MEMBER_URL=
FLIMAS_PROVIDER_DIRECTORY_URL=
FLIMAS_ANDROID_URL=
FLIMAS_IOS_URL=
CONSENT_NOTICE_VERSION=2026-10-draft
LANGUAGE_CATALOG_PATH=data/languages.json
APPROVED_KNOWLEDGE_PATH=data/approved_knowledge.json
KNOWLEDGE_MATCH_THRESHOLD=0.42
SATISFACTION_SURVEY_ENABLED=true

# API resilience
API_TIMEOUT_SECONDS=10
API_MAX_RETRIES=2
PAYMENT_POLL_INTERVAL_SECONDS=30
PAYMENT_POLL_MAX_ATTEMPTS=20

# Server configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
RELOAD=true
APP_ENV=development
MENU_CATALOGUE_V11_ENABLED=true
